{
  "schema_version": "1.0",
  "mode": "read-only",
  "allowed_repositories": ["KyleAlexanderSteen/GAIA-2.0"],
  "allowed_paths": [
    "Documents/**",
    "Documents-2/**",
    "gaia-spec/**",
    "rfcs/**",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "GOVERNANCE.md"
  ],
  "denied_path_patterns": [
    ".env",
    ".env.*",
    "**/*.pem",
    "**/*.key",
    "**/id_rsa",
    "**/secrets/**"
  ],
  "limits": {
    "max_file_bytes": 1048576,
    "max_response_bytes": 1048576,
    "max_results": 50,
    "requests_per_minute": 60,
    "allowed_content_types": [
      "text/plain",
      "text/markdown",
      "application/json",
      "text/x-rust"
    ]
  },
  "audit": {
    "enabled": true,
    "chain_required": true
  }
}
